# ======================================================
# 🌐 Core Server
# Do not commit real .env files.
# Local development uses SQLite.
# Production must use PostgreSQL.
# ======================================================
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
# Backward-compatible alias still supported:
# BASE_URL=http://localhost:3000

# ======================================================
# 🔐 JWT (REQUIRED IN PRODUCTION)
# Use real 64-character random secrets in production.
# ======================================================
JWT_ACCESS_SECRET=replace_with_64_char_random
JWT_REFRESH_SECRET=replace_with_64_char_random
COOKIE_SECURE=false

# ======================================================
# 🎥 JITSI / LIVE CLASS
# ======================================================
# Local development:
# NODE_ENV=development
# BASE_URL=http://localhost:3000
# JITSI_DOMAIN=meet.jit.si
#
# JaaS:
# JITSI_DOMAIN=8x8.vc
# JITSI_APP_ID=your_jaas_app_id
# JITSI_APP_SECRET=your_jaas_app_secret
# JITSI_JWT_AUDIENCE=jitsi
# JITSI_JWT_ISSUER=chat
# JITSI_JWT_SUBJECT=8x8.vc
#
# Production:
# set JITSI_DOMAIN to your real self-hosted Jitsi domain
# example: meet.studiestalk.com
JITSI_DOMAIN=meet.jit.si

# Jitsi JWT app credentials from your self-hosted deployment.
# These are typically blank in local development when using meet.jit.si.
JITSI_APP_ID=studiestalk
JITSI_APP_SECRET=replace_with_your_jitsi_app_secret

# Usually keep these defaults unless your Jitsi token auth setup differs
JITSI_AUDIENCE=jitsi
JITSI_JWT_AUDIENCE=jitsi
JITSI_JWT_ISSUER=studiestalk
JITSI_JWT_SUBJECT=meet.jit.si
JITSI_SECURE_DOMAIN=true

# ======================================================
# 📧 EMAIL CONFIGURATION
# ======================================================
# Options:
# disabled  -> logs emails only (safe dev mode)
# gmail     -> uses Gmail SMTP
EMAIL_PROVIDER=disabled

# Sender identity
EMAIL_FROM_EMAIL=no-reply@yourschool.com
EMAIL_FROM_NAME=StudiesTalk

# Gmail SMTP (legacy option)
GMAIL_SMTP_USER=your_email@gmail.com
GMAIL_SMTP_PASS=your_gmail_app_password

# IONOS / generic SMTP (current primary integration in server code)
IONOS_SMTP_HOST=
IONOS_SMTP_PORT=465
IONOS_SMTP_SECURE=true
IONOS_SMTP_USER=
IONOS_SMTP_PASS=
IONOS_SMTP_FROM_NAME=StudiesTalk

# Optional IMAP inbox sync
IONOS_IMAP_HOST=
IONOS_IMAP_PORT=993
IONOS_IMAP_SECURE=true
IONOS_IMAP_USER=
IONOS_IMAP_PASS=


# ======================================================
# 🌍 GOOGLE TRANSLATE
# ======================================================
TRANSLATION_PROVIDER=google
TRANSLATION_FALLBACK=local

GOOGLE_TRANSLATE_KEYFILE=server/secrets/gcp-translate-key.json
# or
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/key.json


# ======================================================
# 📱 TWILIO (Optional)
# ======================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ======================================================
# 🎞 Media Conversion (ffmpeg)
# ======================================================
# auto   -> prefer ffmpeg-static if installed; fallback to system ffmpeg
# system -> force using system-installed ffmpeg
# static -> force using ffmpeg-static (error if not available)
FFMPEG_MODE=auto

# Optional: override exact ffmpeg path
# FFMPEG_PATH=/usr/bin/ffmpeg

# If true: conversion failures abort uploads.
# If false: conversion errors are logged but uploads still succeed.
FFMPEG_STRICT=false

# ======================================================
# 💾 Persistent Storage (SQLite now, PostgreSQL-ready)
# ======================================================
# Local development default.
DB_ENGINE=sqlite

# Billing can be rehearsed separately during the staged migration.
BILLING_DB_ENGINE=sqlite
TASKS_DB_ENGINE=sqlite
ATTENDANCE_DB_ENGINE=sqlite

# Default SQLite dev database inside the repo.
DB_PATH=storage/studiestalk.db

# Production-ready PostgreSQL settings.
# DB_ENGINE=postgres
# BILLING_DB_ENGINE=postgres
# TASKS_DB_ENGINE=postgres
# ATTENDANCE_DB_ENGINE=postgres
# CHANNELS_DB_ENGINE=postgres
# MESSAGES_DB_ENGINE=postgres
# DATABASE_URL=postgres://user:password@host:5432/studiestalk
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=studiestalk
# PGUSER=studiestalk_user
# PGPASSWORD=your_password
# PGSSL=false

DB_BACKUP_DIR=backup
DB_BACKUP_INTERVAL_HOURS=24
DB_BACKUP_ON_START=false
UPLOADS_DIR=uploads
UPLOAD_MAX_FILE_BYTES=26214400
FILE_STORAGE_ADAPTER=local
# FILE_STORAGE_LOCAL_ROOT=uploads/managed
# Use object storage before serious customer usage.
FILE_STORAGE_ENCRYPTION_ENABLED=false
# 64 hex chars for AES-256-GCM when encryption is enabled
# FILE_STORAGE_ENCRYPTION_KEY=
FILE_STORAGE_ENCRYPTION_KEY_ID=file-key-v1
FILE_UPLOAD_IMAGE_MAX_BYTES=10485760
FILE_UPLOAD_DOCUMENT_MAX_BYTES=26214400
FILE_UPLOAD_AUDIO_MAX_BYTES=52428800
FILE_UPLOAD_VIDEO_MAX_BYTES=209715200

# Production recommended example (VPS):
# DB_PATH=/var/lib/studiestalk/studiestalk.db
# DB_BACKUP_DIR=/var/backups/studiestalk
# UPLOADS_DIR=/app/uploads
# FILE_STORAGE_LOCAL_ROOT=/app/uploads/managed

# ======================================================
# 🤖 AI / OpenAI Realtime (optional)
# ======================================================
# OAuth-style Realtime sessions expect the server to mint ephemeral tokens,
# so keep your API key secret in this backend.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-4o-mini-realtime-preview
OPENAI_REALTIME_URL=https://api.openai.com/v1/realtime/client_secrets
OPENAI_REALTIME_VOICE=alloy
AI_INPUT_TOKEN_RATE_EUR=0.000015
AI_OUTPUT_TOKEN_RATE_EUR=0.00002
AI_IDLE_TIMEOUT_SECONDS=45
AI_CLEANUP_SWEEP_SECONDS=30
# Optional: time-based rate for session logging (EUR per second)
AI_TIME_RATE_EUR_PER_SECOND=0.000166
