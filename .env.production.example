NODE_ENV=production
PORT=3000
HOST=0.0.0.0
APP_BASE_URL=https://app.example.com
COOKIE_SECURE=true

# Generate strong random values. Do not reuse development secrets.
JWT_ACCESS_SECRET=replace_with_64_plus_character_random_secret
JWT_REFRESH_SECRET=replace_with_64_plus_character_random_secret
PLATFORM_SECRETS_MASTER_KEY=replace_with_32_plus_character_random_secret
PLATFORM_SECRETS_EXPECT_DB=true

# Database
DB_ENGINE=postgres
DATABASE_URL=postgresql://studiestalk:replace_with_password@postgres:5432/studiestalk
DB_BACKUP_DIR=/app/backup
DB_BACKUP_INTERVAL_HOURS=24
DB_BACKUP_ON_START=false

# Storage
UPLOADS_DIR=/app/uploads
UPLOAD_MAX_FILE_BYTES=26214400
FILE_STORAGE_ADAPTER=local
FILE_STORAGE_LOCAL_ROOT=/app/uploads
# FILE_STORAGE_ADAPTER=r2
# S3_ENDPOINT=https://example.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=studiestalk-prod
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# FILE_STORAGE_ENCRYPTION_ENABLED=true
# FILE_STORAGE_ENCRYPTION_KEY=replace_with_64_hex_characters

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLIC_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
STRIPE_DEFAULT_CURRENCY=eur

# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0

# Email / SMTP
EMAIL_PROVIDER=ionos
EMAIL_FROM=StudiesTalk <no-reply@example.com>
EMAIL_FROM_EMAIL=no-reply@example.com
EMAIL_FROM_NAME=StudiesTalk
IONOS_SMTP_HOST=smtp.ionos.de
IONOS_SMTP_PORT=465
IONOS_SMTP_SECURE=true
IONOS_SMTP_USER=
IONOS_SMTP_PASS=
IONOS_IMAP_HOST=imap.ionos.de
IONOS_IMAP_PORT=993
IONOS_IMAP_SECURE=true
IONOS_IMAP_USER=
IONOS_IMAP_PASS=

# AI
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-4o-mini-realtime-preview
OPENAI_REALTIME_URL=https://api.openai.com/v1/realtime/client_secrets

# SMS / Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=

# Video
JITSI_DOMAIN=video.example.com
JITSI_APP_ID=
JITSI_APP_SECRET=
JITSI_JWT_AUDIENCE=jitsi
JITSI_JWT_ISSUER=
JITSI_JWT_SUBJECT=

# Operational evidence
OPS_EVIDENCE_DIR=/app/storage/ops
