# ======================================================
# StudiesTalk staging environment example
# This file is production-shaped on purpose.
# Copy to your staging secret manager or .env on the host.
# Do not commit real secrets.
# ======================================================

NODE_ENV=production
PORT=3000
APP_BASE_URL=https://staging.studiestalk.example.com
COOKIE_SECURE=true

# Strong secrets only. Do not reuse development placeholders.
JWT_ACCESS_SECRET=replace_with_64_char_random
JWT_REFRESH_SECRET=replace_with_64_char_random

# ======================================================
# Database
# Recommended for staging: PostgreSQL
# ======================================================
DB_ENGINE=postgres
BILLING_DB_ENGINE=postgres
TASKS_DB_ENGINE=postgres
ATTENDANCE_DB_ENGINE=postgres
CHANNELS_DB_ENGINE=postgres
MESSAGES_DB_ENGINE=postgres

DATABASE_URL=postgres://user:password@host:5432/studiestalk
PGSSL=true

# Keep backup artifacts on persistent disk even with PostgreSQL runtime.
DB_BACKUP_DIR=/var/backups/studiestalk
DB_BACKUP_INTERVAL_HOURS=24
DB_BACKUP_ON_START=false

# ======================================================
# File storage
# Supported adapters:
# - local
# - s3
# - s3_compatible
# - r2
# ======================================================
UPLOADS_DIR=/var/lib/studiestalk/uploads
UPLOAD_MAX_FILE_BYTES=26214400
FILE_STORAGE_ADAPTER=local
FILE_STORAGE_LOCAL_ROOT=/var/lib/studiestalk/uploads/managed
# Strong warning: move to object storage before serious customer usage.
# FILE_STORAGE_ADAPTER=r2
# S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=studiestalk-staging
# S3_ACCESS_KEY_ID=replace_with_s3_access_key_id
# S3_SECRET_ACCESS_KEY=replace_with_s3_secret_access_key
# S3_FORCE_PATH_STYLE=true
FILE_STORAGE_ENCRYPTION_ENABLED=false
# FILE_STORAGE_ENCRYPTION_KEY=64_hex_chars_if_enabled
FILE_STORAGE_ENCRYPTION_KEY_ID=file-key-v1
FILE_UPLOAD_IMAGE_MAX_BYTES=10485760
FILE_UPLOAD_DOCUMENT_MAX_BYTES=26214400
FILE_UPLOAD_AUDIO_MAX_BYTES=52428800
FILE_UPLOAD_VIDEO_MAX_BYTES=209715200

# ======================================================
# Email
# Leave disabled if staging does not need outbound mail.
# ======================================================
EMAIL_PROVIDER=disabled
EMAIL_FROM_EMAIL=no-reply@staging.studiestalk.example.com
EMAIL_FROM_NAME=StudiesTalk

# SMTP / IONOS if enabled
# IONOS_SMTP_HOST=
# IONOS_SMTP_PORT=465
# IONOS_SMTP_SECURE=true
# IONOS_SMTP_USER=
# IONOS_SMTP_PASS=
# IONOS_SMTP_FROM_NAME=StudiesTalk

# Optional inbox sync
# IONOS_IMAP_HOST=
# IONOS_IMAP_PORT=993
# IONOS_IMAP_SECURE=true
# IONOS_IMAP_USER=
# IONOS_IMAP_PASS=

# ======================================================
# Twilio (optional)
# ======================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=
MOBILE_OTP_PROXY_URL=

# ======================================================
# ffmpeg
# ======================================================
FFMPEG_MODE=auto
FFMPEG_STRICT=false

# ======================================================
# OpenAI realtime (optional)
# ======================================================
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-4o-mini-realtime-preview
OPENAI_REALTIME_URL=https://api.openai.com/v1/realtime/client_secrets
OPENAI_REALTIME_VOICE=alloy
AI_INPUT_TOKEN_RATE_EUR=0.000015
AI_OUTPUT_TOKEN_RATE_EUR=0.00002
AI_TIME_RATE_EUR_PER_SECOND=0.000166
AI_IDLE_TIMEOUT_SECONDS=45
AI_CLEANUP_SWEEP_SECONDS=30

# ======================================================
# Jitsi / live classes
# Public meet.jit.si cannot do automatic moderator JWT hosting.
# Use 8x8.vc JaaS or self-hosted Jitsi for host auto-join.
# ======================================================
JITSI_DOMAIN=8x8.vc
JITSI_APP_ID=replace_with_jaas_app_id
JITSI_APP_SECRET=replace_with_jaas_app_secret
JITSI_JWT_AUDIENCE=jitsi
JITSI_JWT_ISSUER=chat
JITSI_JWT_SUBJECT=8x8.vc
